{
  "name": "jedi-party-scheduler-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute jedi-party-scheduler-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute jedi-party-scheduler-db --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/luxon": "^3.4.2",
    "typescript": "^5.6.2",
    "wrangler": "^3.80.0"
  }
}

{
  "name": "jedi-party-scheduler-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply jedi-party-scheduler-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jedi-party-scheduler-db --remote",
    "db:migrate:status": "wrangler d1 migrations list jedi-party-scheduler-db --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "luxon": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20250101.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^26.1.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.20.0"
  }
}
